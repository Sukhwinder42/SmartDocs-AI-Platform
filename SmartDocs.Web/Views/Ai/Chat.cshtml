<style>
    .chat-container {
        height: 70vh;
        display: flex;
        flex-direction: column;
    }

    .chat-box {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .msg-row {
        display: flex;
        margin-bottom: 12px;
    }

    .msg-user {
        justify-content: flex-end;
    }

    .msg-ai {
        justify-content: flex-start;
    }

    .bubble {
        max-width: 70%;
        padding: 10px 14px;
        border-radius: 15px;
        white-space: pre-line;
    }

    .bubble-user {
        background: #0d6efd;
        color: white;
    }

    .bubble-ai {
        background: #e9ecef;
        color: black;
    }

    .typing {
        font-style: italic;
        color: gray;
        margin: 10px;
    }
</style>

<div class="row">

    <div class="col-md-3">
        <div class="card">
            <div class="card-header">Documents</div>
            <div class="card-body">AI Document Assistant</div>
        </div>
    </div>

    <div class="col-md-9">

        <div class="card chat-container">

            <div class="card-header">Chat With Document</div>

            <div class="card-body chat-box" id="chatBox">

                @foreach (var msg in Model.ChatHistory)
                {
                    <div class="msg-row msg-user">
                        <div class="bubble bubble-user">@msg.User</div>
                    </div>

                    <div class="msg-row msg-ai">
                        <div class="bubble bubble-ai">@msg.AI</div>
                    </div>
                }

            </div>

            <div class="card-footer">

                <input type="hidden" id="docId" value="@Model.DocumentId" />

                <div class="input-area d-flex gap-2">

                    <textarea id="question"
                              class="form-control"
                              rows="2"
                              placeholder="Ask follow-up question..."></textarea>

                    <button class="btn btn-primary" onclick="sendMessage()">
                        Ask
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    let chatBox = document.getElementById("chatBox");

    function scrollToBottom() {
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function addMessage(text, isUser) {
        let div = document.createElement("div");
        div.className = "msg-row " + (isUser ? "msg-user" : "msg-ai");

        div.innerHTML = `
            <div class="bubble ${isUser ? 'bubble-user' : 'bubble-ai'}">
                ${text}
            </div>
        `;

        chatBox.appendChild(div);
        scrollToBottom();
    }

    function showTyping() {
        let div = document.createElement("div");
        div.id = "typing";
        div.className = "typing";
        div.innerText = "AI is thinking...";
        chatBox.appendChild(div);
        scrollToBottom();
    }

    function removeTyping() {
        let t = document.getElementById("typing");
        if (t) t.remove();
    }

    async function sendMessage() {

        let questionBox = document.getElementById("question");
        let question = questionBox.value;
        let docId = document.getElementById("docId").value;

        if (!question.trim()) return;

        addMessage(question, true);
        questionBox.value = "";

        showTyping();

        let response = await fetch('/Ai/AskAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                documentId: docId,
                question: question
            })
        });

        let data = await response.json();

        removeTyping();
        addMessage(data.answer, false);
    }

    scrollToBottom();
</script>