<div class="row">

    <div class="col-lg-4 col-6">

        <div class="small-box bg-gradient-info">

            <div class="inner">

                <h3>@ViewBag.TotalDocuments</h3>

                <p>Total Documents</p>

            </div>

            <div class="icon">

                <i class="fas fa-file-alt"></i>

            </div>

        </div>

    </div>

    <div class="col-lg-4 col-6">

        <div class="small-box bg-gradient-success">

            <div class="inner">

                <h3>@ViewBag.TotalSummaries</h3>

                <p>AI Summaries</p>

            </div>

            <div class="icon">

                <i class="fas fa-robot"></i>

            </div>

        </div>

    </div>

    <div class="col-lg-4 col-6">

        <div class="small-box bg-gradient-warning">

            <div class="inner">

                <h3>@ViewBag.TotalChats</h3>

                <p>AI Chats</p>

            </div>

            <div class="icon">

                <i class="fas fa-comments"></i>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-md-12">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">

                    SmartDocs AI Platform

                </h3>

            </div>

            <div class="card-body">

                <p>
                    Upload PDFs, DOCX files, and images.
                    Use AI-powered summaries and chat with documents.
                </p>

            </div>

        </div>

    </div>

</div>