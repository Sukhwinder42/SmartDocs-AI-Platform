@model SmartDocs.Web.ViewModels.LoginViewModel


<div class="row justify-content-center">

    <div class="col-md-4">

        <div class="card card-primary">

            <div class="card-header">
                <h3 class="card-title">
                    SmartDocs Login
                </h3>
            </div>

            <div class="card-body">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form method="post">

                    <div class="form-group mb-3">

                        <label>Email</label>

                        <input asp-for="Email"
                               class="form-control" />

                    </div>

                    <div class="form-group mb-3">

                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-block w-100">

                        Login

                    </button>

                </form>

                <hr />

                <div class="text-center mt-3">

                    <p>
                        New to SmartDocs?
                    </p>

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-success w-100">

                        Create New Account

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>